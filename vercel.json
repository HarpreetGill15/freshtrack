{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-reminder?slot=summer", "schedule": "0 11 * * *" },
    { "path": "/api/send-reminder?slot=winter", "schedule": "0 12 * * *" }
  ]
}
